# Copy to .env and fill in. .env is gitignored.

# Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Gmail search query used by `scan` to find camp-related emails.
# Adjust the keywords to match how your camps phrase their reminders.
CAMP_GMAIL_QUERY=newer_than:90d (camp OR registration OR enrollment OR forms OR "summer program" OR waiver)
